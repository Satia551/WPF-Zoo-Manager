<Window x:Class="WPF_Zoo_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Zoo_Manager"
        mc:Ignorable="d"
        Title="Zoo Manager" Height="500" Width="530"
        ResizeMode="NoResize"
        FontSize="15"
        WindowStyle="None">
        <Window.Resources>
                <LinearGradientBrush x:Key="ZooBgGradient" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A88C83" Offset="0.0" />
                        <GradientStop Color="#4A3730" Offset="1.0" />
                </LinearGradientBrush>
                <SolidColorBrush x:Key="BgBeige" Color="#E7DED0"></SolidColorBrush>
                <SolidColorBrush x:Key="ForestGreen" Color="#25502B"/>
                <SolidColorBrush x:Key="WoodBrown" Color="#73564A"/>
                <SolidColorBrush x:Key="DangerRed" Color="#5A3A31"/>
                <SolidColorBrush x:Key="DarkGreen" Color="#3A7D44"/>
                <Style TargetType="Button">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        
                        <Setter Property="Effect">
                                <Setter.Value>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3"/>
                                </Setter.Value>
                        </Setter>
    
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" 
                                                        Background="{TemplateBinding Background}" 
                                                        CornerRadius="3" 
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                        
                                                        <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Effect" Value="{x:Null}"/>
                                                                <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                                <TranslateTransform Y="1.5"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="1"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" 
                                                        Background="Transparent" 
                                                        BorderBrush="Transparent" 
                                                        BorderThickness="1" 
                                                        CornerRadius="2" 
                                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#65483E"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#4A3730"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#33241F"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                                <Grid x:Name="Bg" SnapsToDevicePixels="true" Width="8">
                                                        <!-- Tło toru suwaka -->
                                                        <Border Background="#4A3730" CornerRadius="4" Opacity="0.5"/>
                                                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                                <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                        
                                                                        <Thumb>
                                                                                <Thumb.Template>
                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                                <Border Background="{StaticResource BgBeige}" CornerRadius="4"/>
                                                                                        </ControlTemplate>
                                                                                </Thumb.Template>
                                                                        </Thumb>
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                                                </Track.IncreaseRepeatButton>
                                                        </Track>
                                                </Grid>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>
        
        <Grid Background="{StaticResource ZooBgGradient}">
                <Grid.RowDefinitions>
                        <RowDefinition Height="30"/> 
                        <RowDefinition Height="*"/>  
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource ForestGreen}" MouseDown="TitleBar_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                
                                <Image Source="Zoo_Icon.jpg" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="Zoo Manager" 
                                   Foreground="{StaticResource BgBeige}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0" 
                                   FontWeight="Bold"/></StackPanel>
                        
                        <Button Content="✕" 
                                HorizontalAlignment="Right" 
                                Width="30" 
                                Height="30" 
                                Background="Transparent" 
                                Foreground="{StaticResource BgBeige}"
                                Click="CloseButton_Click"/>
                </Grid>
                <Grid Grid.Row="1">
                <Label Content="Zoo List" Background="{StaticResource ForestGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="60,10,0,0" VerticalAlignment="Top"/>
        <ListBox Name="listZoos" Background="{StaticResource WoodBrown}" Foreground = "{StaticResource BgBeige}" SelectionChanged="listZoos_SelectionChanged" HorizontalAlignment="Left" Height="175" Margin="10,41,0,0" VerticalAlignment="Top" Width="158"/>
        
        <Label Content="Associated Animals List" Background="{StaticResource ForestGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="170,10,0,0" VerticalAlignment="Top"/>
        <ListBox Name="listAssociatedAnimals" Background="{StaticResource WoodBrown}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Height="175" Margin="170,41,0,0" VerticalAlignment="Top" Width="165"/>
        
        <ListBox Name="listAllAnimals" Background="{StaticResource WoodBrown}" Foreground = "{StaticResource BgBeige}" SelectionChanged="listAllAnimals_SelectionChanged" HorizontalAlignment="Left" Height="280" Margin="340,41,0,0" VerticalAlignment="Top" Width="158" />

        <Button Content="Delete Zoo" Background="{StaticResource DangerRed}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="10,221,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="DeleteZoo_Click" />
        <Button Content="Add Zoo" Background="{StaticResource DarkGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="10,290,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="AddZoo_Click" />
        <Button Content="Update Zoo" HorizontalAlignment="Left" Background="{StaticResource DarkGreen}" Foreground = "{StaticResource BgBeige}" Margin="10,330,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="UpdateZoo_Click" />
        <Button Content="Remove Animal" Background="{StaticResource DangerRed}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="175,221,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="RemoveAnimal_Click" />
        <Button Content="Add Animal" Background="{StaticResource DarkGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="175,290,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="AddAnimal_Click" />
        
        <Button Content="Update Animal" Background="{StaticResource DarkGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="175,330,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="UpdateAnimal_Click" />
        <Button Content="Delete Animal" Background="{StaticResource DangerRed}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="340,330,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="DeleteAnimal_Click" />
        <Button Content="Add Animal to Zoo" Background="{StaticResource DarkGreen}" Foreground = "{StaticResource BgBeige}" HorizontalAlignment="Left" Margin="340,10,0,0" VerticalAlignment="Top" Width="158" Height="30"
                Click="addAnimalToZoo_Click" />
        <TextBox Name="myTextBox" Background = "{StaticResource BgBeige}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="28" Margin="12,256,0,0" TextWrapping="Wrap" Width="318"/>
    </Grid> </Grid>
</Window>
